{
  "name": "tenali-add-sub",
  "private": true,
  "description": "Prototype workspace for tenali-add-sub",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "install:all": "npm --prefix frontend install && npm --prefix backend install",
    "install": "npm run install:all",
    "lint:frontend": "npm --prefix frontend run lint",
    "test:frontend": "npm --prefix frontend run test",
    "check:frontend": "npm run lint:frontend && npm run test:frontend && npm run build:frontend"
  }
}
